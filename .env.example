# Application Settings
PROJECT_NAME="FinanceHub"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Secrets
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 

# Database Configuration (PostgreSQL)
POSTGRES_USER="admin"
POSTGRES_PASSWORD="admin123" 
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="finance_hub"  
DATABASE_URL="postgresql+psycopg2://${POSTGRES_USER}:$ {POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"
ASYNC_DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Default Super Admin Seed Credentials
ADMIN_EMAIL="admin@financehub.local"
ADMIN_PASSWORD="AdminPassword123!" 

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
